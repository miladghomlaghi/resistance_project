library(rxode2)
mod1 <-RxODE({
KA <- .294
CL=18.6
V2=40.2 # central
Q =10.5
V3=297.# peripheral
Kin=1
Kout = 1 # Missing parameter
EC50=200
C2 = centr/V2;
C3 = peri/V3;
d/dt(depot) =-KA*depot;
f(depot) = 0.5
d/dt(centr) <- KA*depot - CL*C2 - Q*C2 + Q*C3;
d/dt(peri)  =                    Q*C2 - Q*C3;
d/dt(eff)  = Kin - Kout*(1-C2/(EC50+C2))*eff;
eff(0) = 1
})
# You can see what parameters are needed by the summary function:
# summary(mod1)
# This is a simple code that plots the ODE system.
# Don't worry about `et` if you don't understand it now
# It will be covered in another tutorial
rxSolve(mod1,et(amt=10000, ii=12, until=24) %>% et(0,24,length.out=24)) %>%
plot(centr, eff)
mod1 <-RxODE({
KA <- .294
CL=18.6
V2=40.2 # central
Q =10.5
V3=297.# peripheral
Kin=1
alag(depot)=3
Kout = 1 # Missing parameter
EC50=200
C2 = centr/V2;
C3 = peri/V3;
d/dt(depot) =-KA*depot;
f(depot) = 0.5
d/dt(centr) <- KA*depot - CL*C2 - Q*C2 + Q*C3;
d/dt(peri)  =                    Q*C2 - Q*C3;
d/dt(eff)  = Kin - Kout*(1-C2/(EC50+C2))*eff;
eff(0) = 1
})
