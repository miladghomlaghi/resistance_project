source("C:/Users/milad/Desktop/resistance_09_12_final/validation/SRC-7_10/match_topologies_with_paths.R")
traceback()
# results <- foreach::foreach(r = 1:nrow(all_combi),
#                             .combine = "rbind",
#                             .packages = c("igraph", "prodlim"),
#                             .verbose = TRUE) %dopar% {
for (i in 1:nrow(all_combi)) {
print(r)
source("../../R/Strict/F05_get_sign.R")
source("../../R/Strict/F06_get_link.R")
source("../../R/Strict/F07_get_link_path.R")
combi <- rep(0, num_nodes)
combi[1] <- near_name
combi[2] <- all_combi[r, ][[1]]
combi[3] <- all_combi[r, ][[2]]
combi <- matrix(combi, nrow = 1, ncol = num_nodes)
combi_names <- near_nodes[unlist(combi)]
topo  <- rep(0, num_nodes ^ 2)
paths <- vector("list", num_nodes ^ 2)
# build the realised 3-node topology AND record the path per edge
for (i in 1:nrow(combi_nodes)) {
tmp_nodes <- p[-combi_nodes[i, ]]
tmp_names <- combi_names[tmp_nodes]
tmp_net   <- igraph::delete_vertices(near_net, unlist(tmp_names))
tmp_res   <- get_link_path(tmp_net,
unlist(combi_names[combi_nodes[i, 1]]),
unlist(combi_names[combi_nodes[i, 2]]), links)
if (!is.na(tmp_res$sign)) {
topo[positions[i]]    <- tmp_res$sign
paths[[positions[i]]] <- tmp_res$path
}
}
# test the realised topology against each of the 42 target topologies
rec <- NULL
for (ii in 1:nrow(topos_to_match)) {
nz <- as.vector(topos_to_match[ii, ] != 0)
if (!is.na(prodlim::row.match(topo[nz],
as.data.frame(topos_to_match[ii, nz]), nomatch = NA))) {
# one row per NON-NULL edge of the matched topology,
# carrying the full path (intermediates) for that edge
edge_tbl <- do.call(rbind, lapply(which(nz), function(pos) {
fr  <- combi_nodes[pos, 1]
to  <- combi_nodes[pos, 2]
pth <- paths[[pos]]
data.frame(
X1        = combi_names[1],
X2        = combi_names[2],
X3        = combi_names[3],
topo_id   = ii,
highly_robust  = ii >= 35,
edge_pos  = pos,
from_slot = fr,              # 1=X1, 2=X2, 3=X3
to_slot   = to,
from_name = combi_names[fr],
to_name   = combi_names[to],
sign      = topo[pos],
path      = if (length(pth) >= 1) paste(pth, collapse = ">") else "",
path_len  = if (length(pth) >= 1) length(pth) - 1 else NA_integer_,
n_intermediate = max(0, length(pth) - 2),
intermediates  = if (length(pth) > 2)
paste(pth[2:(length(pth) - 1)], collapse = ">") else "",
stringsAsFactors = FALSE)
}))
rec <- rbind(rec, edge_tbl)
}
}
rec
}
